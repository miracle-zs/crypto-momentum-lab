# Generate a unique alphanumeric value and store the real file as .env.server.
CML_POSTGRES_PASSWORD=replace_with_random_password
CML_CODE_COMMIT=replace_with_deployed_git_commit
CML_LIVE_ACCOUNT_LABEL=primary
# Comma-separated labels whose live positions must remain protected by the
# shared market-data subscription set. Leave blank to use the single label.
# CML_LIVE_POSITION_ACCOUNT_LABELS=primary,account-2,account-3,account-4
CML_LIVE_ENTRY_POLICY_MODE=enforce
CML_LIVE_IMPULSE_WINDOW_BUCKETS=3
CML_LIVE_CONFIRMATION_BUCKETS=1
CML_LIVE_MIN_RETURN_PCT=0.01
CML_LIVE_MIN_IMBALANCE=0.40
CML_LIVE_MIN_INTENSITY=2
CML_LIVE_COOLDOWN_BUCKETS=0
# Additional account profiles used by compose.live.accounts.yaml.
CML_LIVE_IMPULSE_WINDOW_BUCKETS_ACCOUNT_2=4
CML_LIVE_CONFIRMATION_BUCKETS_ACCOUNT_2=1
CML_LIVE_MIN_RETURN_PCT_ACCOUNT_2=0.01
CML_LIVE_MIN_IMBALANCE_ACCOUNT_2=0.40
CML_LIVE_MIN_INTENSITY_ACCOUNT_2=2
CML_LIVE_COOLDOWN_BUCKETS_ACCOUNT_2=0
CML_LIVE_IMPULSE_WINDOW_BUCKETS_ACCOUNT_3=2
CML_LIVE_CONFIRMATION_BUCKETS_ACCOUNT_3=1
CML_LIVE_MIN_RETURN_PCT_ACCOUNT_3=0.005
CML_LIVE_MIN_IMBALANCE_ACCOUNT_3=0.50
CML_LIVE_MIN_INTENSITY_ACCOUNT_3=2
CML_LIVE_COOLDOWN_BUCKETS_ACCOUNT_3=0
CML_LIVE_IMPULSE_WINDOW_BUCKETS_ACCOUNT_4=2
CML_LIVE_CONFIRMATION_BUCKETS_ACCOUNT_4=1
CML_LIVE_MIN_RETURN_PCT_ACCOUNT_4=0.005
CML_LIVE_MIN_IMBALANCE_ACCOUNT_4=0.50
CML_LIVE_MIN_INTENSITY_ACCOUNT_4=2
CML_LIVE_COOLDOWN_BUCKETS_ACCOUNT_4=0
# These must be filled with hashes generated by each account's image before
# its Live service is started.
CML_LIVE_STRATEGY_CONFIG_HASH_ACCOUNT_2=
CML_LIVE_STRATEGY_CONFIG_HASH_ACCOUNT_3=
CML_LIVE_STRATEGY_CONFIG_HASH_ACCOUNT_4=
CML_LIVE_MIGRATION_REVISION_ACCOUNT_2=20260831_0029
CML_LIVE_MIGRATION_REVISION_ACCOUNT_3=20260831_0029
CML_LIVE_MIGRATION_REVISION_ACCOUNT_4=20260831_0029
# Optional logical database-plane overrides. Leave blank to use the same
# PostgreSQL instance with separate bounded connection pools.
# CML_EXECUTION_DATABASE_URL=
# CML_MARKET_DATABASE_URL=
# CML_OBSERVABILITY_DATABASE_URL=
# Durable exchange telemetry allow-list. Production rollout uses submit,cancel.
# Leave blank only to preserve legacy all-operation persistence.
# CML_LIVE_PERSIST_EXCHANGE_OPERATIONS=submit,cancel
# Required role-specific Binance credentials for the long-running live services.
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=
# The optional compose.live.accounts.yaml overlay uses one read/trade pair per
# additional account.  Keep these names distinct; do not copy a secret across
# Binance accounts.
BINANCE_READ_API_KEY_ACCOUNT_2=
BINANCE_READ_API_SECRET_ACCOUNT_2=
BINANCE_TRADE_API_KEY_ACCOUNT_2=
BINANCE_TRADE_API_SECRET_ACCOUNT_2=
BINANCE_READ_API_KEY_ACCOUNT_3=
BINANCE_READ_API_SECRET_ACCOUNT_3=
BINANCE_TRADE_API_KEY_ACCOUNT_3=
BINANCE_TRADE_API_SECRET_ACCOUNT_3=
BINANCE_READ_API_KEY_ACCOUNT_4=
BINANCE_READ_API_SECRET_ACCOUNT_4=
BINANCE_TRADE_API_KEY_ACCOUNT_4=
BINANCE_TRADE_API_SECRET_ACCOUNT_4=
# Legacy BINANCE_API_KEY/SECRET are intentionally not injected into live
# services. Manual migration commands must provide an explicit credential store.
# Internal service-to-service WebSocket addresses use compose defaults.
# CML_MARKET_STATE_HUB_URL=ws://market-data:8766
# CML_ACCOUNT_EVENT_HUB_URL=ws://execution-account-live:8767
# CML_ACCOUNT_EVENT_HUB_HOST=0.0.0.0
# CML_ACCOUNT_EVENT_HUB_PORT=8767
