# Copy these values into the server's untracked environment file or secret store.
# Never commit a real Binance key or secret.
# Required role-specific variables for the long-running live services.
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=
# Legacy BINANCE_API_KEY/SECRET are intentionally not injected into live
# services. Manual migration commands must provide an explicit credential store.

CML_LIVE_ACCOUNT_LABEL=primary
CML_LIVE_STRATEGY=orderflow_impulse
CML_LIVE_SESSION_ID=live-primary-v1
CML_LIVE_OPERATOR=operator
CML_LIVE_LEASE_OWNER=live-worker
CML_LIVE_STRATEGY_CONFIG_HASH=
CML_LIVE_ENTRY_POLICY_MODE=enforce
CML_LIVE_MIGRATION_REVISION=20260814_0016
CML_LIVE_ENTRY_LEVERAGE=5
# Durable exchange telemetry allow-list. Keep submit/cancel for the live
# audit trail; omit the value to preserve all-operation persistence.
# CML_LIVE_PERSIST_EXCHANGE_OPERATIONS=submit,cancel

# Choose the paper account variant to mirror in live execution.
CML_LIVE_EXIT_MODE=candle_15m
CML_LIVE_TAKE_PROFIT_PCT=0.02
CML_LIVE_STOP_LOSS_PCT=0.01
CML_LIVE_ENTRY_POSITIVE_GAINER_TOP_COUNT=10
CML_LIVE_CANDLE_GRACE_BARS=8
CML_LIVE_CANDLE_GRACE_DECISION_PROFIT_PCT=0.001
CML_LIVE_CANDLE_GRACE_PROFIT_PCT=0.0088
