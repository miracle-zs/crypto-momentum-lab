# Optional HTTPS endpoint.  Leave empty to keep alerts in journald only.
CML_ALERT_WEBHOOK_URL=

# Optional Server酱 SendKey.  When set, it takes precedence over the generic
# webhook above and sends alert/recovery messages using title + Markdown body.
# Keep this file outside Git with mode 0600.
SERVERCHAN_SENDKEY=

# Optional authenticated heartbeat endpoint hosted outside the trading host.
# The receiver should alert after several missed intervals and must not have
# credentials or write access to the trading system.
CML_OPS_EXTERNAL_HEARTBEAT_URL=
CML_OPS_EXTERNAL_HEARTBEAT_TOKEN=
CML_OPS_EXTERNAL_HEARTBEAT_TIMEOUT_SECONDS=5

# The live session identity used to scope runtime log queries.
CML_LIVE_SESSION_ID=live-primary-v1
CML_LIVE_ACCOUNT_LABEL=primary

# Alert de-duplication window.  A condition is still evaluated every minute.
CML_ALERT_COOLDOWN_SECONDS=900

# Database growth uses a six-hour trend to filter short bursts. An active
# warning resolves only after the rate stays below 80% of its warning budget
# for 30 minutes; repeated growth reminders are at most six hours apart.
CML_STORAGE_GROWTH_MINIMUM_WINDOW_SECONDS=21600
CML_STORAGE_GROWTH_RECOVERY_FRACTION=0.8
CML_STORAGE_GROWTH_RECOVERY_SECONDS=1800
CML_DATABASE_STORAGE_ALERT_COOLDOWN_SECONDS=21600

# Persistent copy of an unhealthy account worker's Docker log stream for
# operator diagnosis. Leave empty only if an external log
# collector is guaranteed to retain the same container stream.
CML_CRASH_LOG_DIRECTORY=/var/lib/crypto-momentum-lab/crash-logs

# Position comparison thresholds.
CML_POSITION_STALE_AFTER_SECONDS=120
CML_POSITION_QUANTITY_TOLERANCE=0.00000001
CML_CONSISTENCY_WINDOW_SECONDS=300
