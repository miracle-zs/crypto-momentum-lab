# Optional HTTPS endpoint.  Leave empty to keep alerts in journald only.
CML_ALERT_WEBHOOK_URL=

# Optional Server酱 SendKey.  When set, it takes precedence over the generic
# webhook above and sends alert/recovery messages using title + Markdown body.
# Keep this file outside Git with mode 0600.
SERVERCHAN_SENDKEY=

# The live session and lease identity used for checkpoint/Hub freshness.
CML_LIVE_SESSION_ID=live-primary-v1
CML_LIVE_ACCOUNT_LABEL=primary
CML_LIVE_LEASE_OWNER=live-worker

# Alert de-duplication window.  A condition is still evaluated every minute.
CML_ALERT_COOLDOWN_SECONDS=900

# Automatically restart only the affected live-strategy service when its
# local heartbeat makes Docker mark it unhealthy/dead. Set false to keep the
# monitor alert-only. The restart budget is per account and per stale incident.
CML_AUTO_RESTART_STALE_LIVE_SERVICES=true
CML_LIVE_RESTART_COOLDOWN_SECONDS=900
CML_LIVE_RESTART_MAX_ATTEMPTS=3
