# Optional HTTPS endpoint.  Leave empty to keep alerts in journald only.
CML_ALERT_WEBHOOK_URL=

# The live session and lease identity used for checkpoint/Hub freshness.
CML_LIVE_SESSION_ID=live-primary-v1
CML_LIVE_ACCOUNT_LABEL=primary
CML_LIVE_LEASE_OWNER=live-worker

# Alert de-duplication window.  A condition is still evaluated every minute.
CML_ALERT_COOLDOWN_SECONDS=900
