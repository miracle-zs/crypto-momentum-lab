[Unit]
Description=Crypto Momentum Lab operational alert monitor
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crypto-momentum-lab
Environment=PYTHONUNBUFFERED=1
Environment=CML_PROJECT_DIRECTORY=/opt/crypto-momentum-lab
Environment=CML_COMPOSE_ENV_FILE=/opt/crypto-momentum-lab/.env.server
Environment=CML_CRASH_LOG_DIRECTORY=/var/lib/crypto-momentum-lab/crash-logs
Environment=CML_MARKET_REVISION_PURGE_TIMER_UNIT=cml-market-revision-purge.timer
Environment=CML_MARKET_REVISION_ARCHIVE_TIMER_UNIT=cml-market-revision-archive.timer
Environment=CML_STORAGE_PATH=/var/lib/docker
Environment=CML_DATABASE_STORAGE_MONITORING=true
# cml_ops_monitor always watches the NextGen services; account sessions are
# loaded from the runtime settings in .env.server. Explicit service/account
# overrides remain available in /etc/crypto-momentum-lab/ops-monitor.env.
EnvironmentFile=-/etc/crypto-momentum-lab/ops-monitor.env
# Keep host and Docker probes bounded; account recovery remains operator-controlled.
ExecStart=/usr/bin/python3 /opt/crypto-momentum-lab/deploy/ops/cml_ops_monitor.py --command-timeout-seconds 120
Restart=always
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
