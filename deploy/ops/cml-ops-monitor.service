[Unit]
Description=Crypto Momentum Lab operational alert monitor
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crypto-momentum-lab
Environment=PYTHONUNBUFFERED=1
Environment=CML_PROJECT_DIRECTORY=/opt/crypto-momentum-lab
Environment=CML_COMPOSE_FILE=/opt/crypto-momentum-lab/compose.server.yaml,/opt/crypto-momentum-lab/compose.live.accounts.yaml
Environment=CML_COMPOSE_PROFILES=live
Environment=CML_COMPOSE_ENV_FILE=/opt/crypto-momentum-lab/.env.server
Environment=CML_CRASH_LOG_DIRECTORY=/var/lib/crypto-momentum-lab/crash-logs
# cml_ops_monitor derives live services, sessions, and lease owners from the
# Compose files above. CML_MONITOR_SERVICES and CML_MONITOR_LIVE_ACCOUNTS remain
# supported in /etc/crypto-momentum-lab/ops-monitor.env for explicit overrides.
EnvironmentFile=-/etc/crypto-momentum-lab/ops-monitor.env
ExecStart=/usr/bin/python3 /opt/crypto-momentum-lab/deploy/ops/cml_ops_monitor.py
Restart=always
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
