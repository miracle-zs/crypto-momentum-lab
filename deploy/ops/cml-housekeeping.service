[Unit]
Description=Crypto Momentum Lab host artefact retention
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/crypto-momentum-lab
ExecStart=/opt/crypto-momentum-lab/deploy/ops/cml_housekeeping.sh
NoNewPrivileges=true
PrivateTmp=true

# No [Install]: the timer drives this unit.
