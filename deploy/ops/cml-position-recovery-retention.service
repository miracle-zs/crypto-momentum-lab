[Unit]
Description=Crypto Momentum Lab bounded position recovery retention
Documentation=file:///opt/crypto-momentum-lab/docs/runbooks/postgres-operations.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/crypto-momentum-lab
# Keep the newest per-scope checkpoint and all current execution-head
# bindings. Only covered state copies older than 72 hours are candidates.
ExecStart=/usr/bin/flock -n -E 0 /run/lock/cml-position-recovery-retention.lock /usr/bin/docker exec crypto-momentum-lab-dashboard-1 python -m crypto_momentum_lab.tools.prune_position_recovery_history --apply --minimum-age-hours 72 --max-checkpoints 100000 --max-events 500000 --batch-size 500 --lock-timeout-seconds 5
TimeoutStartSec=20m
Nice=10
NoNewPrivileges=true
PrivateTmp=true

# No [Install]: the timer drives this unit.
